# Copy this file to .env and fill in real values. Never commit .env.

# Secret used to sign login (JWT) tokens. Generate one with:
#   node -e "console.log(require('crypto').randomBytes(64).toString('hex'))"
ACCESS_TOKEN_SECRET=

# MongoDB connection string, e.g. mongodb://127.0.0.1:27017/travel-story
MONGODB_URI=

# Groq API key for AI features (https://console.groq.com)
GROQ_API_KEY=
GROQ_MODEL=

# Outgoing mail for password reset emails (e.g. Gmail: smtp.gmail.com, 587,
# and an App Password). Without these, reset links are printed to the console.
SMTP_HOST=
SMTP_PORT=587
SMTP_EMAIL=
SMTP_PASSWORD=
SMTP_FROM=

# Optional
# PORT=8001
# BASE_URL=http://localhost:8001
# FRONTEND_URL=http://localhost:5173   (where reset links in emails point)
